datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model WebsiteSetting {
  id              String   @id @default("default")
  storeName       String   @default("Jijau Computers")
  tagline         String   @default("Your Tech Partner")
  logoUrl         String   @default("")
  darkLogoUrl     String   @default("")
  faviconUrl      String   @default("")
  primaryColor    String   @default("#1d4ed8") // Indigo/Blue
  secondaryColor  String   @default("#f97316") // Orange accent
  phone           String   @default("+91 98765 43210")
  whatsapp        String   @default("919876543210")
  email           String   @default("contact@jijaucomputers.com")
  address         String   @default("Shop No. 4, Jijau Complex, Station Road, Pune, Maharashtra 411001")
  googleMapsUrl   String   @default("https://maps.google.com/?q=Pune,Maharashtra")
  openingHours    String   @default("Mon - Sat: 10:00 AM - 9:00 PM | Sunday: 11:00 AM - 6:00 PM")
  gstin           String   @default("27AAAAA0000A1Z5")
  upiId           String   @default("jijauc@ibl")
  upiName         String   @default("Jijau Computers")
  facebookUrl     String   @default("https://facebook.com")
  instagramUrl    String   @default("https://instagram.com")
  youtubeUrl      String   @default("https://youtube.com")
  linkedinUrl     String   @default("https://linkedin.com")
  metaTitle       String   @default("Jijau Computers - Best Computer & Laptop Store in Pune")
  metaDescription String   @default("Shop high performance gaming PCs, laptops, components, CCTV, and get quick repair services at Jijau Computers.")
  metaKeywords    String   @default("computer store, gaming pc, laptops, pc repair, processors, graphics card, jijau computers")
  sliderInterval     Int      @default(5) // Default auto-slider interval in seconds
  invoiceTerms       String   @default("1. Warranty valid only with official serial number and intact warranty seals.\n2. Goods once sold are subject to manufacturer standard warranty policy.\n3. Physical damage, liquid spillage, or unauthorized modifications are not covered under warranty.\n4. Disputes subject to Pune Jurisdiction only.")
  invoiceBankDetails String   @default("Bank: HDFC Bank Ltd | A/C No: 50200012345678 | IFSC: HDFC0001234 | Branch: Station Road, Pune")
  invoiceHsnCode     String   @default("84713010")
  invoiceNotes       String   @default("Thank you for choosing Jijau Computers Pune - Your Trusted Tech Partner!")
  updatedAt          DateTime @updatedAt
}

model AdminUser {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String   // Admin password
  name      String   @default("Store Admin")
  email     String   @unique
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  imageUrl    String?
  iconName    String?   @default("Monitor")
  order       Int       @default(0)
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Brand {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  logoUrl   String?
  isActive  Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  sku           String?        @unique
  description   String
  shortDesc     String?
  price         Float
  salePrice     Float?
  stock         Int            @default(10)
  inStock       Boolean        @default(true)
  warranty      String?        @default("1 Year Brand Warranty")
  isFeatured    Boolean        @default(false)
  isBestseller  Boolean        @default(false)
  isNewArrival  Boolean        @default(false)
  isTrending    Boolean        @default(false)
  isGamingDeal  Boolean        @default(false)
  videoUrl      String?        // Multiple URLs can be stored (comma/newline separated)
  sliderSeconds Int?           @default(5) // Auto-slider time in seconds (default 5s)
  specsJson     String?        // JSON string of key-value specs
  categoryId    String
  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  brandId       String?
  brand         Brand?         @relation(fields: [brandId], references: [id], onDelete: SetNull)
  images        ProductImage[]
  orderItems    OrderItem[]
  reviews       Review[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model ProductImage {
  id        String   @id @default(cuid())
  url       String
  isPrimary Boolean  @default(false)
  order     Int      @default(0)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Offer {
  id            String    @id @default(cuid())
  title         String
  badge         String?   @default("FESTIVE DEAL")
  description   String
  bannerUrl     String?
  discountPct   Int?      @default(15)
  couponCode    String?
  startDate     DateTime?
  endDate       DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Banner {
  id          String   @id @default(cuid())
  title       String
  subtitle    String?
  tag         String?  @default("Special Promotion")
  imageUrl    String
  ctaText     String?  @default("Explore Now")
  ctaLink     String?  @default("/products")
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CustomPcRequest {
  id          String   @id @default(cuid())
  reqNumber   String   @unique
  customerName String
  phone       String
  email       String?
  budget      String
  purpose     String   // Gaming, Office, Video Editing, AI/ML, Programming, etc.
  cpuPref     String?
  gpuPref     String?
  ramPref     String?
  storagePref String?
  cabinetPref String?
  notes       String?
  status      String   @default("PENDING") // PENDING, REVIEWING, QUOTED, ACCEPTED, COMPLETED, CANCELLED
  adminNotes  String?
  totalEst    Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ServiceRequest {
  id          String   @id @default(cuid())
  ticketId    String   @unique // e.g. JC-SRV-1001
  customerName String
  phone       String
  email       String?
  deviceType  String   // Laptop, Desktop, Printer, Motherboard, GPU, CCTV, Other
  brand       String
  model       String
  serialNo    String?
  issueDesc   String
  status      String   @default("Received") // Received, Under Inspection, Repairing, Waiting for Parts, Ready for Delivery, Completed
  adminNotes  String?
  estimatedCost Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model QuotationRequest {
  id           String   @id @default(cuid())
  quoteNumber  String   @unique
  customerName String
  companyName  String?
  phone        String
  email        String
  type         String   @default("Bulk Order") // Single Product, Multi-Product, Bulk Order, Corporate B2B
  itemsSummary String   // JSON or text description of requested items
  message      String?
  status       String   @default("PENDING") // PENDING, PROCESSING, QUOTED, CLOSED
  adminNotes   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Enquiry {
  id          String   @id @default(cuid())
  name        String
  phone       String
  email       String?
  subject     String
  message     String
  productName String?
  status      String   @default("NEW") // NEW, CONTACTED, RESOLVED
  adminNotes  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id         String   @id @default(cuid())
  name       String
  email      String   @unique
  phone      String   @unique
  password   String
  avatarUrl  String?
  isVerified Boolean  @default(true)
  address    String?
  city       String?
  pincode    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  orders     Order[]
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName String
  phone       String
  email       String?
  address     String
  city        String
  pincode     String
  notes       String?
  items       OrderItem[]
  subtotal    Float
  discount    Float       @default(0)
  tax         Float       @default(0)
  total       Float
  paymentMode String      @default("CASH_ON_DELIVERY") // COD, UPI_WHATSAPP, BANK_TRANSFER
  status      String      @default("PENDING") // PENDING, CONFIRMED, PROCESSING, SHIPPED, DELIVERED, CANCELLED
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  price     Float
  quantity  Int
}

model VisitorLog {
  id        String   @id @default(cuid())
  ip        String
  location  String?  @default("Pune, Maharashtra, India")
  device    String?  @default("Desktop")
  browser   String?  @default("Chrome")
  os        String?  @default("Windows")
  page      String   @default("/")
  referrer  String?  @default("—")
  userAgent String?
  createdAt DateTime @default(now())
}

model Review {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId          String?
  customerName    String
  customerPhone   String?
  rating          Int      @default(5) // 1 to 5 stars
  title           String
  comment         String
  isVerifiedBuyer Boolean  @default(false)
  isApproved      Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
